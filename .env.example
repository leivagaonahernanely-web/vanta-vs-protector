# Copia este archivo a .env y completa los valores.

# Cadena de conexión MySQL. Sin esto no hay cuentas, login ni NX_KEY: la base de datos
# se usa de forma perezosa (server/db.ts), así que el resto del servidor arranca igual,
# pero todo lo que dependa de una cuenta (incluido el ofuscador vía la web) no funcionará.
# Ejemplo: mysql://usuario:contraseña@host:3306/nombre_bd
DATABASE_URL=

# Secreto para firmar la cookie de sesión (JWT HS256). Usa una cadena larga y aleatoria,
# por ejemplo: openssl rand -hex 32
JWT_SECRET=

# Secreto HMAC para proteger NX_KEY y API keys. También debe ser largo y aleatorio,
# y distinto de JWT_SECRET: openssl rand -hex 32
NX_KEY_SECRET=

# Opcional. Si lo configuras, la cuenta con ese correo se crea como admin Premium sin
# necesitar una NX_KEY (así puedes generar NX_KEY para el resto desde el panel de admin).
# Formato exacto: "email:" + el correo en minúsculas, por ejemplo:
# OWNER_OPEN_ID=email:tucorreo@ejemplo.com
# Si lo dejas vacío, la PRIMERA cuenta que se registre en una base de datos vacía se
# vuelve admin Premium automáticamente (ver auth.register en server/routers.ts).
OWNER_OPEN_ID=

# Puerto del servidor (opcional, por defecto 3000; si está ocupado se usa el siguiente libre).
PORT=3000
